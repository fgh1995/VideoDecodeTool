<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- ============ 调色板（与 SkiaSharp 叠加层保持一致） ============ -->
    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#FF0B0B0F" />
    <SolidColorBrush x:Key="PanelBrush" Color="#FF14141A" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="#FF1B1B22" />
    <SolidColorBrush x:Key="PanelBorderBrush" Color="#FF2A2A34" />

    <!-- 大面板的「隐约边框」与段间分割线：低透明度白，比 PanelBorderBrush 更轻 -->
    <SolidColorBrush x:Key="PanelBorderSubtleBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#1FFFFFFF" />
    <SolidColorBrush x:Key="TextBrush" Color="#FFD8D8E0" />
    <SolidColorBrush x:Key="TextDimBrush" Color="#FF8A8A99" />

    <!--
        强调数值的绿色（参考实现里 QP / GOP / MOTION 那些测量值的配色）：
        参数名仍是灰色、描述性文本仍是白色，只有「量出来的数」用这个绿色。
    -->
    <SolidColorBrush x:Key="AccentValueBrush" Color="#FF6A9955" />

    <!--
        各测量值行的配色（参考实现里每一行的读数颜色不同，和对应图表的柱体同色）：
        QP 黄 / MOTION 用 fwd 青 / GOP 紫 / REORDER 橙。
        帧类型那一行不在这里，它按 I 红 / P 蓝 / B 绿动态取色。
    -->
    <SolidColorBrush x:Key="QpValueBrush" Color="#FFFFD24A" />
    <SolidColorBrush x:Key="MotionValueBrush" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="GopValueBrush" Color="#FFA78BFA" />
    <SolidColorBrush x:Key="ReorderValueBrush" Color="#FFF59E0B" />
    <SolidColorBrush x:Key="AccentBrush" Color="#FF35C2F4" />
    <SolidColorBrush x:Key="ButtonBrush" Color="#FF23232C" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#FF33333F" />
    <SolidColorBrush x:Key="IFrameBrush" Color="#FFEF4444" />
    <SolidColorBrush x:Key="PFrameBrush" Color="#FF2196F3" />
    <SolidColorBrush x:Key="BFrameBrush" Color="#FF4CAF50" />
    <SolidColorBrush x:Key="OtherFrameBrush" Color="#FFE8A33D" />
    <SolidColorBrush x:Key="ForwardBrush" Color="#FF22D3EE" />
    <SolidColorBrush x:Key="BackwardBrush" Color="#FFEC4899" />
    <SolidColorBrush x:Key="BitrateBrush" Color="#FFEF4444" />

    <!--
        合并进度条的两路颜色：播放用主色 AccentBrush（#FF35C2F4），转码用红色。
        转码进度垫在播放进度下层，于是「红色伸出蓝色之外」的右段就是转码已跑到播放前面的部分。
    -->
    <SolidColorBrush x:Key="TranscodeProgressBrush" Color="#FFEF4444" />

    <FontFamily x:Key="MonoFont">Consolas, Microsoft YaHei UI, Segoe UI</FontFamily>

    <!-- ============ 基础文本 ============ -->
    <Style TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
    </Style>

    <Style x:Key="SectionTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>

    <Style x:Key="InfoLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,8,3" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <Style x:Key="InfoValue" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- 测量值（QP / MOTION / GOP / REORDER / 帧类型）的读数：用强调绿 -->
    <Style x:Key="InfoValueAccent" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource AccentValueBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,3" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style x:Key="DimText" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- ============ 面板容器 ============ -->
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--
        右侧信息栏的整体面板：整栏只有这一个边框，而且是「隐约」的 ——
        边框用低透明度白（#14FFFFFF），不做卡片式高对比描边。
    -->
    <Style x:Key="PanelSubtle" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource PanelBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderSubtleBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="12,10,12,4" />
    </Style>

    <!--
        大面板里的一段：不是卡片，而是靠「顶上一条发丝分割线」与上一段分隔。
        自身无底色、无边框、无圆角，段间间距全部由分割线上方的 Padding 提供。
    -->
    <Style x:Key="InfoSection" TargetType="Border">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{StaticResource HairlineBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,9,0,0" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <!-- ============ 按钮 ============ -->
    <Style TargetType="Button">
        <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="MinWidth" Value="62" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Root"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Margin="{TemplateBinding Padding}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Root" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="#FF06121A" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Root" Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="TransportButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="MinWidth" Value="38" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="Padding" Value="6,3" />
    </Style>

    <!-- ============ 下拉框 ============ -->
    <!--
        完整自定义模板：默认 WPF ComboBox 模板的弹出面板与可编辑文本框都是白底，
        在深色主题里对比色完全反掉。这里把「合上的显示框 / 箭头 / 弹出面板 /
        可编辑文本框 / 列表项」全部换成主题色。
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="{StaticResource ButtonBrush}" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <Border x:Name="root"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="16" />
                                </Grid.ColumnDefinitions>

                                <!-- 非编辑模式：展示当前选中项 -->
                                <ContentPresenter x:Name="contentSite" Grid.Column="0"
                                                  Content="{TemplateBinding SelectionBoxItem}"
                                                  ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                                                  Margin="{TemplateBinding Padding}"
                                                  VerticalAlignment="Center"
                                                  HorizontalAlignment="Stretch"
                                                  IsHitTestVisible="False" />

                                <!-- 编辑模式：可输入文本框（透明背景、浅色字/光标） -->
                                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                                         Margin="{TemplateBinding Padding}"
                                         VerticalAlignment="Center"
                                         Background="Transparent"
                                         Foreground="{StaticResource TextBrush}"
                                         CaretBrush="{StaticResource TextBrush}"
                                         SelectionBrush="{StaticResource AccentBrush}"
                                         BorderThickness="0"
                                         Focusable="True"
                                         Visibility="Collapsed" />

                                <!-- 下拉箭头 -->
                                <Path Grid.Column="1" Data="M0,0 L6,0 L3,4 Z" Fill="{StaticResource TextDimBrush}"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      IsHitTestVisible="False" />

                                <!-- 开关按钮：非编辑时覆盖整行点开下拉；编辑时只盖住箭头列 -->
                                <ToggleButton x:Name="toggle" Grid.Column="0" Grid.ColumnSpan="2"
                                              Focusable="False"
                                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                                              ClickMode="Press"
                                              Background="Transparent" BorderThickness="0" />
                            </Grid>
                        </Border>

                        <!-- 弹出面板：深色底 + 边框 + 圆角 -->
                        <Popup x:Name="PART_Popup"
                               IsOpen="{TemplateBinding IsDropDownOpen}"
                               AllowsTransparency="True"
                               Placement="Bottom"
                               PopupAnimation="Slide"
                               Focusable="False">
                            <Border Background="{StaticResource PanelBrush}"
                                    BorderBrush="{StaticResource PanelBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="3"
                                    MinWidth="{Binding ActualWidth, ElementName=root}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}">
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="contentSite" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <!-- 开关只盖箭头列，留出文本框可编辑 -->
                            <Setter TargetName="toggle" Property="Grid.Column" Value="1" />
                            <Setter TargetName="toggle" Property="Grid.ColumnSpan" Value="1" />
                        </Trigger>
                        <Trigger SourceName="toggle" Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- 下拉列表项：透明底 + 浅色字；悬停/选中用按钮悬停色 -->
    <Style TargetType="ComboBoxItem">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="6,3" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Border x:Name="root"
                            Background="{TemplateBinding Background}"
                            Padding="{TemplateBinding Padding}">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                            <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 复选框 ============ -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ============ 进度条 ============ -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Background" Value="#FF1B1B22" />
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- ============ 选项卡（转码参数：视频 / 音频） ============ -->
    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="root" Padding="16,5" Margin="0,0,2,0"
                            Background="{StaticResource ButtonBrush}"
                            BorderBrush="{StaticResource PanelBorderBrush}"
                            BorderThickness="1,1,1,0"
                            CornerRadius="3,3,0,0">
                        <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                        </Trigger>
                        <!-- 选中态放最后：多条触发器命中时后写的优先 -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="root" Property="Background" Value="{StaticResource AccentBrush}" />
                            <Setter Property="Foreground" Value="#FF0B0B0F" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- ============ 滑块 ============ -->
    <Style TargetType="Slider">
        <Setter Property="Foreground" Value="{StaticResource AccentBrush}" />
        <!-- 背景留空：默认模板会把 Background 画成整条凹槽的底色，
             深色主题下那条深灰长条很显眼（界面反馈「去掉滑动条的背景色」）。 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Margin" Value="0,0,6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="20" />
    </Style>

    <!--
        ============ 提示气泡 ============
        WPF 默认 ToolTip 是「浅底 + 深字」，但本窗口整体 Foreground 是浅色，
        会被继承进气泡内容里 —— 结果成了「浅底 + 浅字」，几乎读不出来
        （界面反馈：下拉框的提示词对比度不对）。这里显式改成深底浅字。
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="#FF1E1E26" />
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="HasDropShadow" Value="False" />
    </Style>

    <!--
        悬浮在图表上方的行标题：不再占用左侧一列，直接叠在图表左上角，
        这样图表能占满整行宽度，和右上角的量程读数左右对称。
    -->
    <Style x:Key="FloatingChartTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="6,2,10,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Panel.ZIndex" Value="12" />
    </Style>

    <!-- ============ 图表标题条 ============ -->
    <Style x:Key="ChartTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="Margin" Value="2,4,6,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Top" />
    </Style>

    <!-- 图表右侧的当前值读数 -->
    <Style x:Key="ChartReadout" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="8,0,2,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextAlignment" Value="Right" />
    </Style>

    <!--
        悬浮在图表右上角的量程读数：
        原右侧那条固定读数栏取消后，各行「当前数值范围」改为叠在图上显示。
    -->
    <Style x:Key="AxisRangeReadout" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextDimBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Margin" Value="0,1,6,0" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Panel.ZIndex" Value="12" />
    </Style>

    <!-- 播放头右侧的当前值读数：叠加在柱状图之上，位置由 ViewModel 下发 -->
    <Style x:Key="PlayheadReadout" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource TextBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource MonoFont}" />
        <Setter Property="FontSize" Value="11" />
        <!-- 背景用**与图表一致的不透明色**（图表底色 = #FF0E0E14）：
             播放头处的当前时间因此能自然盖住它压着的那一个刻度文字。
             早先是半透明的 #E6121219，底下的刻度会透出来（实测反馈）。 -->
        <Setter Property="Background" Value="#FF0E0E14" />
        <Setter Property="Padding" Value="3,1" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>

</ResourceDictionary>
