<Window x:Class="VideoDecodeTool.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:lvc="clr-namespace:LiveChartsCore.SkiaSharpView.WPF;assembly=LiveChartsCore.SkiaSharpView.WPF"
        xmlns:views="clr-namespace:VideoDecodeTool.Views"
        Title="视频解码分析工具 · 运动矢量 / 帧类型 / QP 可视化"
        Width="1560" Height="940" MinWidth="1120" MinHeight="680"
        WindowState="Maximized"
        Background="{StaticResource AppBackgroundBrush}"
        Foreground="{StaticResource TextBrush}"
        AllowDrop="True"
        WindowStartupLocation="CenterScreen"
        DragOver="OnWindowDragOver"
        Drop="OnWindowDrop">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid>

    <DockPanel>

        <!--
            顶部工具栏已取消：原来放在这里的控件都已并入右侧信息栏 ——
            「打开源片」在「文件信息」段标题旁，转码设置与开始/取消在「转码设置」段，
            叠加层开关与矢量缩放在「叠加层」段。省下来的高度全部让给预览区与图表区。
        -->

        <!-- 底部状态栏已移除（界面反馈：这条 播放结束 / FFmpeg 版本 的信息条没用，占高度） -->

        <!-- ==================== 主体 ==================== -->
        <Grid Margin="8">
            <!-- 上半：视频预览（左 1/4）+ 信息面板（右 1/4）；下半：图表区（占 1/2） -->
            <Grid.RowDefinitions>
                <RowDefinition Height="*" MinHeight="200" />
                <RowDefinition Height="6" />
                <RowDefinition Height="*" MinHeight="250" />
            </Grid.RowDefinitions>

            <!--
                上半行：预览列宽度由可用高度按 16:9 反推（见 OnTopGridSizeChanged），
                因此预览卡片正好铺满自己的列、不再两侧留空，多出来的横向空间全部让给右侧参数面板。
            -->
            <Grid Grid.Row="0" SizeChanged="OnTopGridSizeChanged">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition x:Name="PreviewColumn" Width="*" MinWidth="320" />
                    <ColumnDefinition Width="6" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!--
                    视频预览：外层 PreviewSlot 铺满这一格（它就是「可用区域」），
                    里面的 PreviewCard 按 16:9 **内接**放进这块区域（见 OnPreviewSlotSizeChanged）——
                    宽、高都不会超出可用空间，所以放大窗口 / 拖动分隔条时卡片既不会被行高裁掉，
                    也不会被拉成 19:7 之类更扁的比例。
                    卡片 Padding 归零，画面因此正好铺满整张卡片。
                -->
                <Border x:Name="PreviewSlot" Grid.Column="0" SizeChanged="OnPreviewSlotSizeChanged">
                    <Border x:Name="PreviewCard" Style="{StaticResource Panel}"
                            Padding="0" Margin="0"
                            HorizontalAlignment="Center" VerticalAlignment="Top">
                        <!-- PreviewFrame：黑底画面容器。它的圆角要和 PreviewCard 的圆角（4 - 1 边框 = 3）
                             对上，并由 OnPreviewFrameSizeChanged 按同一半径裁剪，
                             否则 SkiaSharp 画出来的直角画面会把卡片圆角盖掉。 -->
                        <Border x:Name="PreviewFrame" Background="#FF06060A" CornerRadius="3"
                                SizeChanged="OnPreviewFrameSizeChanged">
                            <skia:SKElement x:Name="PreviewSurface" />
                        </Border>
                    </Border>
                </Border>

                <GridSplitter Grid.Column="1" Width="6" HorizontalAlignment="Stretch" Background="Transparent" />

                <!-- 右侧信息与进度 -->
                <ScrollViewer x:Name="InfoScroll" Grid.Column="2"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <!-- 右侧两张卡片左右并排：左 = 媒体信息，右 = 控制与预览 -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <!-- 左卡片：媒体信息（文件信息 / 帧参数 / 帧统计）；
                             卡片本身铺满行高，内容在里面垂直居中 -->
                        <Border Grid.Column="0" Style="{StaticResource Panel}"
                                Margin="0,0,6,0">
                            <StackPanel VerticalAlignment="Center">

                        <!-- 文件信息（首段：顶上不需要分割线） -->
                        <Border Style="{StaticResource InfoSection}" BorderThickness="0">
                            <StackPanel>
                                <TextBlock Text="文件信息" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="文件" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FileNameText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="封装" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FormatText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="视频" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding VideoText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding VideoLayoutText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="色彩" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding ColorText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="时长" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding LengthText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="音频" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding AudioText}" Style="{StaticResource InfoValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 帧参数 -->
                        <Border Style="{StaticResource InfoSection}">
                            <StackPanel>
                                <TextBlock Text="帧参数" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="66" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="帧号" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding FrameHeaderText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="类型" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding FrameTypeText}"
                                               Style="{StaticResource InfoValueAccent}" Foreground="{Binding FrameTypeBrush}" />

                                    <TextBlock Grid.Row="2" Grid.Column="0" Text="大小" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding FrameSizeText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="3" Grid.Column="0" Text="QP" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding FrameQpText}"
                                               Style="{StaticResource InfoValueAccent}" Foreground="{StaticResource QpValueBrush}" />

                                    <TextBlock Grid.Row="4" Grid.Column="0" Text="运动" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding FrameMotionText}"
                                               Style="{StaticResource InfoValueAccent}" Foreground="{StaticResource MotionValueBrush}" />

                                    <TextBlock Grid.Row="5" Grid.Column="0" Text="GOP" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="5" Grid.Column="1" Text="{Binding FrameGopText}"
                                               Style="{StaticResource InfoValueAccent}" Foreground="{StaticResource GopValueBrush}" />

                                    <TextBlock Grid.Row="6" Grid.Column="0" Text="重排" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="6" Grid.Column="1" Text="{Binding FrameReorderText}"
                                               Style="{StaticResource InfoValueAccent}" Foreground="{StaticResource ReorderValueBrush}" />

                                    <TextBlock Grid.Row="7" Grid.Column="0" Text="标志" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="7" Grid.Column="1" Text="{Binding FrameFlagsText}" Style="{StaticResource InfoValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 帧统计 -->
                        <Border Style="{StaticResource InfoSection}">
                            <StackPanel>
                                <TextBlock Text="帧统计" Style="{StaticResource SectionTitle}" />

                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="14" />
                                        <ColumnDefinition Width="20" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Border Grid.Row="0" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                            Background="{StaticResource IFrameBrush}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="I" Style="{StaticResource InfoValue}" Margin="4,0,0,2" />
                                    <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding IFrameRow}" Style="{StaticResource InfoValue}" />

                                    <Border Grid.Row="1" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                            Background="{StaticResource PFrameBrush}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="P" Style="{StaticResource InfoValue}" Margin="4,0,0,2" />
                                    <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PFrameRow}" Style="{StaticResource InfoValue}" />

                                    <Border Grid.Row="2" Grid.Column="0" Width="10" Height="10" VerticalAlignment="Center"
                                            Background="{StaticResource BFrameBrush}" />
                                    <TextBlock Grid.Row="2" Grid.Column="1" Text="B" Style="{StaticResource InfoValue}" Margin="4,0,0,2" />
                                    <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding BFrameRow}" Style="{StaticResource InfoValue}" />

                                    <!--
                                        X（其他帧类型）一行已删掉：H.264/HEVC 解码器不会产出该类型，
                                        实测恒为「0 frames  0.0%  0.00 MB  0.0%」（界面反馈），占一行没有意义。
                                    -->
                                </Grid>

                                <TextBlock Text="{Binding TotalFramesText}" Style="{StaticResource DimText}" />

                                <!--
                                    合并进度条（转码 + 播放并成一条，放在帧信息下方）：
                                    转码进度（红）垫底、播放进度（主色）叠在上层，
                                    于是「红色伸出蓝色之外」的右段即「转码已跑到播放前面」的部分。
                                    图例在进度条上方分两行：第一行「播放 xx%」，
                                    第二行「转码 xx%」+ 转码实时读数（frame / 时间 / 速度 / 码流 / 大小）。
                                -->
                                <StackPanel Margin="0,8,0,0">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="9" Height="9" VerticalAlignment="Center"
                                                Background="{StaticResource AccentBrush}" />
                                        <TextBlock Text="播放" Style="{StaticResource DimText}"
                                                   Margin="5,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding PlaybackPercentText}" Style="{StaticResource InfoValue}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>

                                    <!--
                                        第二行：「转码 xx%」图例 + 转码实时读数（帧 / 时间 / 速度 / 码流 / 大小）。
                                        百分比挪到 frame … 左边，读起来是一条完整的转码状态；
                                        这一行整体在「播放」那一行下方，长文本不会把图例行撑爆。
                                    -->
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                        <Border Width="9" Height="9" VerticalAlignment="Center"
                                                Background="{StaticResource TranscodeProgressBrush}" />
                                        <TextBlock Text="转码" Style="{StaticResource DimText}"
                                                   Margin="5,0,3,0" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding ProgressText}" Style="{StaticResource InfoValue}"
                                                   VerticalAlignment="Center" />

                                        <TextBlock Text="{Binding ProgressDetailText}" Style="{StaticResource DimText}"
                                                   Margin="12,0,0,0" VerticalAlignment="Center"
                                                   Visibility="{Binding IsTranscoding, Converter={StaticResource BoolToVisibility}}" />
                                    </StackPanel>

                                    <Grid>
                                        <!-- 底层：转码进度（红）。高度 6 覆盖主题里的 10，进度条更细 -->
                                        <ProgressBar Value="{Binding ProgressPercent, Mode=OneWay}"
                                                     Minimum="0" Maximum="100" Height="6"
                                                     Foreground="{StaticResource TranscodeProgressBrush}" />
                                        <!-- 上层：播放进度（主色）；Background 必须透明，否则会整条盖掉底层的红 -->
                                        <ProgressBar Value="{Binding PlaybackPercent, Mode=OneWay}"
                                                     Minimum="0" Maximum="100" Height="6"
                                                     Background="Transparent" />
                                    </Grid>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                            </StackPanel>
                        </Border>

                        <!-- 右卡片：控制与预览（转码 / 播放 / 叠加层）；
                             卡片本身铺满行高，内容在里面垂直居中 -->
                        <Border Grid.Column="1" Style="{StaticResource Panel}"
                                Margin="6,0,0,0">
                            <StackPanel VerticalAlignment="Center">

                        <!-- 转码设置（本模块首段，顶上不要分割线） -->
                        <Border Style="{StaticResource InfoSection}"
                                BorderThickness="0">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <TextBlock Grid.Column="0" Text="转码设置" Style="{StaticResource SectionTitle}" />

                                    <!-- 打开视频：从「文件信息」段搬来，放在开始转码左侧 -->
                                    <Button Grid.Column="1" Content="打开视频" Command="{Binding OpenFileCommand}"
                                            MinWidth="84" Margin="0,-2,6,6" VerticalAlignment="Top" />

                                    <!-- 转码按钮在「开始转码 / 停止转码」之间切换；停止时会询问如何处理已转码部分 -->
                                    <Button Grid.Column="2" Content="{Binding TranscodeButtonText}"
                                            Command="{Binding TranscodeButtonCommand}"
                                            MinWidth="84" Margin="0,-2,0,6" VerticalAlignment="Top" />
                                </Grid>

                                <!-- 转码实时读数已上移到「帧统计」段的合并进度条图例里（「转码」百分比左边） -->

                                <!--
                                    转码参数：视频 / 音频 两个选项卡（省纵向空间）。
                                    视频：编码器 / 帧大小 / 调整大小质量·方法 / 码控 / 码流 / 质量 /
                                          多步编码·编码类型 / 配置文件 / 速度·质量 / 调谐 / 帧速率。
                                    两栏排布：标签列各自 Auto，标签与控件统一 Center + 相同下边距（对齐）。
                                -->
                                <TabControl Margin="0,8,0,0">
                                    <TabItem Header="视频">
                                        <!-- SizeChanged 记下本页高度，用作音频页的最小高度，切换页签时面板不再跳动 -->
                                        <Grid x:Name="VideoParamsPanel" Margin="0,10,0,0"
                                              SizeChanged="OnVideoParamsPanelSizeChanged">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" MinWidth="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="编码器" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <DockPanel Grid.Row="0" Grid.Column="1" Margin="0,0,12,6">
                                                <Button DockPanel.Dock="Right" Content="检测 GPU" Command="{Binding DetectGpuCommand}"
                                                        Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <!-- 不设 DisplayMemberPath：直接渲染 GpuEncoderInfo.ToString()，
                                                     即「NVIDIA NVENC (h264_nvenc) - 可用」——
                                                     只显示状态文本会让所有选项都变成「可用」，看不出是哪个编码器 -->
                                                <ComboBox ItemsSource="{Binding GpuEncoders}"
                                                          SelectedItem="{Binding SelectedEncoder}"
                                                          ToolTip="{Binding EncoderSummary}" />
                                            </DockPanel>

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="配置文件" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="0" Grid.Column="3" Margin="0,0,0,6"
                                                      ItemsSource="{Binding ProfileOptions}"
                                                      SelectedItem="{Binding SelectedProfile}"
                                                      ToolTip="自动 = 编码器默认（H.264 通常为 High）；AMD AMF 不支持 Baseline（会忽略该档）" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="帧大小" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" IsEditable="True" Margin="0,0,12,6"
                                                      ItemsSource="{Binding ResolutionPresets}"
                                                      Text="{Binding ResolutionText, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="保持源分辨率，或选 / 直接输入目标尺寸（如 1280x720）；留空或「保持源分辨率」= 不缩放" />

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="速度/质量" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,6"
                                                      ItemsSource="{Binding SpeedOptions}"
                                                      SelectedItem="{Binding SelectedSpeed}"
                                                      ToolTip="自动 = 各家默认档（NVENC p4 / QSV、x264 medium / AMF balanced）" />

                                            <!-- 帧大小只保留「帧大小」一个入口（可编辑下拉，直接填 1280x720 也可）：
                                                 之前「帧大小」与「宽 × 高」两个入口会打架，谁生效看不出来（实测反馈）。 -->
                                            <TextBlock Grid.Row="2" Grid.Column="0" Text="调谐" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="2" Grid.Column="1" Margin="0,0,12,6"
                                                      ItemsSource="{Binding TuneOptions}"
                                                      SelectedItem="{Binding SelectedTune}"
                                                      ToolTip="胶片 / 动画 / 低延迟仅 x264 与 NVENC 生效；QSV、AMF 无此参数" />

                                            <TextBlock Grid.Row="3" Grid.Column="0" Text="调整大小质量" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,0,12,6"
                                                      ItemsSource="{Binding ScaleQualityOptions}"
                                                      SelectedItem="{Binding SelectedScaleQuality}"
                                                      ToolTip="缩放采样算法：良好=双线性（快）/ 更好=双三次 / 最好=Lanczos" />

                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="帧速率" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="2" Grid.Column="3" IsEditable="True" Margin="0,0,0,6"
                                                      ItemsSource="{Binding FrameRateOptions}"
                                                      Text="{Binding FrameRateText, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="自动（保持源） = 不传 -r；也可直接输入自定义帧率（如 120、29.97、30000/1001）；选具体帧率会按 CFR 丢/补帧" />

                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="调整大小的方法" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="3" Grid.Column="3" Margin="0,0,0,6"
                                                      ItemsSource="{Binding ResizeModeOptions}"
                                                      SelectedItem="{Binding SelectedResizeMode}"
                                                      ToolTip="仅在设置了目标画幅时生效：保持比例加框 / 拉伸铺满（会变形）/ 裁剪铺满" />

                                            <TextBlock Grid.Row="4" Grid.Column="0" Text="码控" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,0,12,6"
                                                      ItemsSource="{Binding BitrateModeOptions}"
                                                      SelectedItem="{Binding SelectedBitrateMode}"
                                                      ToolTip="质量模式按 CRF/CQ 恒质量编码；指定码流按目标平均码率编码 —— 两者不会同时生效" />

                                            <TextBlock Grid.Row="4" Grid.Column="2" Text="码流" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="4" Grid.Column="3" IsEditable="True" Margin="0,0,0,6"
                                                      IsEnabled="{Binding IsBitrateValueEnabled}"
                                                      ItemsSource="{Binding BitratePresets}"
                                                      Text="{Binding BitrateText, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="kbps；仅「指定码流」模式生效" />

                                            <!-- 「多步编码」= 单步 / 双步，与「编码类型」（编解码格式）是两件事：
                                                 原先这里叫「编码类型」，容易和编码格式混淆，现分开显示。 -->
                                            <TextBlock Grid.Row="5" Grid.Column="0" Text="多步编码" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="5" Grid.Column="1" Margin="0,0,12,6"
                                                      ItemsSource="{Binding EncodingTypeOptions}"
                                                      SelectedItem="{Binding SelectedEncodingType}"
                                                      ToolTip="双步（多步）目前对 NVENC（multipass）与 QSV（look-ahead）生效，其余编码器忽略" />

                                            <!-- 编码类型：跟随上方「编码器」所选后端，列出 ffmpeg 探测到的支持项
                                                 （h264_nvenc / hevc_nvenc / av1_nvenc … 按 -encoders 枚举结果过滤） -->
                                            <TextBlock Grid.Row="5" Grid.Column="2" Text="编码类型" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="5" Grid.Column="3" Margin="0,0,12,6"
                                                      ItemsSource="{Binding VideoCodecTypeOptions}"
                                                      SelectedItem="{Binding SelectedVideoCodecType}"
                                                      ToolTip="列出当前编码器后端经 ffmpeg 探测支持的编码格式；仅做转码输出，源片分析（QP / 运动矢量）不受影响" />

                                            <TextBlock Grid.Row="6" Grid.Column="0" Text="质量" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <DockPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="3" Margin="0,0,0,6">
                                                <Button DockPanel.Dock="Right" Content="打开输出目录" Command="{Binding OpenOutputFolderCommand}"
                                                        MinWidth="98" Margin="6,0,0,0" VerticalAlignment="Center" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding QualityText}" Style="{StaticResource DimText}"
                                                           VerticalAlignment="Center" Margin="0,0,10,0" />
                                                <!-- 指定码流模式下质量滑块归零 + 禁用（下限同时放开到 0，否则会被夹回 12） -->
                                                <Slider Minimum="{Binding QualitySliderMinimum}" Maximum="40"
                                                        TickFrequency="1" IsSnapToTickEnabled="True"
                                                        IsEnabled="{Binding IsQualityEnabled}"
                                                        Value="{Binding Quality}" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Grid>
                                    </TabItem>

                                    <TabItem Header="音频">
                                        <Grid x:Name="AudioParamsPanel" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" MinWidth="56" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" MinWidth="56" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <TextBlock Grid.Row="0" Grid.Column="0" Text="编码器" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="0" Grid.Column="1" Margin="0,0,12,6"
                                                      ItemsSource="{Binding AudioFormatOptions}"
                                                      SelectedItem="{Binding SelectedAudioFormat}"
                                                      ToolTip="「复制源音频」不做重编码：比特率 / 采样率 / 声道设置会被忽略" />

                                            <TextBlock Grid.Row="0" Grid.Column="2" Text="比特率" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="0" Grid.Column="3" IsEditable="True" Margin="0,0,0,6"
                                                      ItemsSource="{Binding AudioBitratePresets}"
                                                      Text="{Binding AudioBitrateText, UpdateSourceTrigger=PropertyChanged}"
                                                      ToolTip="kbps" />

                                            <TextBlock Grid.Row="1" Grid.Column="0" Text="采样率" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="1" Grid.Column="1" Margin="0,0,12,6"
                                                      ItemsSource="{Binding AudioSampleRateOptions}"
                                                      SelectedItem="{Binding SelectedAudioSampleRate}" />

                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="声道" Style="{StaticResource InfoLabel}"
                                                       VerticalAlignment="Center" Margin="0,0,8,6" />
                                            <ComboBox Grid.Row="1" Grid.Column="3" Margin="0,0,0,6"
                                                      ItemsSource="{Binding AudioChannelOptions}"
                                                      SelectedItem="{Binding SelectedAudioChannels}" />
                                        </Grid>
                                    </TabItem>
                                </TabControl>
                            </StackPanel>
                        </Border>

                        <!-- 播放控制 -->
                        <Border Style="{StaticResource InfoSection}">
                            <StackPanel>
                                <TextBlock Text="播放控制" Style="{StaticResource SectionTitle}" />

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="{Binding PlayPauseGlyph}"
                                            Command="{Binding TogglePlayCommand}"
                                            ToolTip="{Binding PlayPauseTooltip}"
                                            Style="{StaticResource TransportButton}" />
                                    <Button Content="⏹"
                                            Command="{Binding StopCommand}"
                                            ToolTip="停止"
                                            Style="{StaticResource TransportButton}" />

                                    <TextBlock Text="{Binding PositionText}" Style="{StaticResource InfoValue}"
                                               VerticalAlignment="Center" Margin="10,0,4,0" />
                                    <TextBlock Text="/" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,4,0" />
                                    <TextBlock Text="{Binding DurationText}" Style="{StaticResource DimText}" VerticalAlignment="Center" />

                                    <TextBlock Text="音量" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="14,0,6,0" />
                                    <Slider Width="90" Minimum="0" Maximum="1" Value="{Binding Volume}" />
                                </StackPanel>

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="52" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <TextBlock Grid.Row="0" Grid.Column="0" Text="模式" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ModeText}" Style="{StaticResource InfoValue}" />

                                    <TextBlock Grid.Row="1" Grid.Column="0" Text="编码器" Style="{StaticResource InfoLabel}" />
                                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding EncoderSummary}" Style="{StaticResource InfoValue}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <!-- 叠加层 -->
                        <Border Style="{StaticResource InfoSection}">
                            <StackPanel>
                                <TextBlock Text="叠加层" Style="{StaticResource SectionTitle}" />

                                <WrapPanel Orientation="Horizontal" Margin="0,0,0,6">
                                    <CheckBox Content="运动矢量" IsChecked="{Binding ShowMotionVectors}" />
                                    <CheckBox Content="帧类型/参数" IsChecked="{Binding ShowFrameTypeOverlay}" />
                                    <CheckBox Content="顶部信息行" IsChecked="{Binding ShowHeaderOverlay}" />
                                </WrapPanel>

                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="矢量放大" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,6,0" />
                                    <Slider Width="100" Minimum="0.25" Maximum="4" Value="{Binding MotionVectorScale}" />
                                    <TextBlock Text="{Binding MotionVectorScaleText}" Style="{StaticResource DimText}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                            </StackPanel>
                        </Border>
                    </Grid>
                </ScrollViewer>
            </Grid>

            <GridSplitter Grid.Row="1" Height="6" HorizontalAlignment="Stretch" Background="Transparent" />

            <!-- ==================== 底部图表区：各层共享 4 秒滑动时间轴（剪辑软件式柱状图） ==================== -->
            <Border Grid.Row="2" Style="{StaticResource Panel}" Margin="0" Padding="6,4">
                <!-- ChartHost：播放头覆盖层的定位基准（View 会把绘图区几何换算到该容器的坐标系） -->
                <Grid x:Name="ChartHost">
                    <Grid.RowDefinitions>
                        <!-- BITRATE：压矮一些，把纵向空间让给下面几层 -->
                        <RowDefinition Height="1.2*" />
                        <!-- FRAME TYPE：I / P / B 三行泳道 -->
                        <RowDefinition Height="1*" />
                        <!-- QP：柱体 + 平均曲线，给高一点才看得清上下沿 -->
                        <RowDefinition Height="1.5*" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="*" />
                        <!-- REORDER：抬高到与其它单层行相当（底部时间刻度与播放头当前时间都落在这一行） -->
                        <RowDefinition Height="1.2*" />
                    </Grid.RowDefinitions>

                    <!-- 1. BITRATE（按 I / P / B 帧着色：I 红 / P 蓝 / B 绿） -->
                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- 标题悬浮在图表上方（不再占用左侧一列，图表因此占满整行宽度）
                             IsHitTestVisible 单独打开：这一行的标题带解释性 ToolTip -->
                        <TextBlock Grid.Column="1" Text="码率 kbps / 帧"
                                   Style="{StaticResource FloatingChartTitle}"
                                   IsHitTestVisible="True"
                                   ToolTip="{Binding BitrateChartHint}" />
                        <Border Grid.Column="1" Background="#FF0E0E14" CornerRadius="2">
                            <lvc:CartesianChart x:Name="BitrateChart"
                                                Series="{Binding BitrateChartSeries}"
                                                XAxes="{Binding BitrateXAxes}"
                                                YAxes="{Binding BitrateYAxes}"
                                                TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                AnimationsSpeed="0:0:0" />
                        </Border>
                        <!-- 量程读数：上沿在右上角、下沿固定 0 在右下角 -->
                        <TextBlock Grid.Column="1" Text="{Binding BitrateMaxText}" Style="{StaticResource AxisRangeReadout}" />
                        <TextBlock Grid.Column="1" Text="0" Style="{StaticResource AxisRangeReadout}"
                                   VerticalAlignment="Bottom" Margin="0,0,6,1" />
                    </Grid>

                    <!-- 2. FRAME TYPE：I / P / B 拆成三条独立泳道（每行一种帧类型、各自着色） -->
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--
                            标题那条 Auto 行的右侧也铺成图表底色：
                            否则这一行会出现一条与图表底色不同的横带，
                            看起来就像 BITRATE 和 FRAME TYPE 之间断开了（实测反馈的「底部有间隔」）。
                        -->
                        <Border Grid.Row="0" Grid.Column="1" Background="#FF0E0E14" />

                        <!-- 标题悬浮在图表上方（不再占左侧一列） -->
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="帧类型" Style="{StaticResource FloatingChartTitle}" />

                        <Border Grid.Row="1" Grid.RowSpan="3" Grid.Column="1" Background="#FF0E0E14" CornerRadius="2">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <lvc:CartesianChart Grid.Row="0"
                                                    Series="{Binding IFrameLane.Series}"
                                                    XAxes="{Binding IFrameLane.XAxes}"
                                                    YAxes="{Binding IFrameLane.YAxes}"
                                                    TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                    AnimationsSpeed="0:0:0" />

                                <lvc:CartesianChart Grid.Row="1"
                                                    Series="{Binding PFrameLane.Series}"
                                                    XAxes="{Binding PFrameLane.XAxes}"
                                                    YAxes="{Binding PFrameLane.YAxes}"
                                                    TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                    AnimationsSpeed="0:0:0" />

                                <lvc:CartesianChart Grid.Row="2"
                                                    Series="{Binding BFrameLane.Series}"
                                                    XAxes="{Binding BFrameLane.XAxes}"
                                                    YAxes="{Binding BFrameLane.YAxes}"
                                                    TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                    AnimationsSpeed="0:0:0" />
                            </Grid>
                        </Border>


                    </Grid>

                    <!-- 3. QP -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <!-- IsHitTestVisible 单独打开：这一行的标题带解释性 ToolTip -->
                        <TextBlock Grid.Column="1" Text="QP 平均（曲线 / 柱）"
                                   Style="{StaticResource FloatingChartTitle}"
                                   IsHitTestVisible="True"
                                   ToolTip="{Binding QpChartTitle}" />
                        <Border Grid.Column="1" Background="#FF0E0E14" CornerRadius="2">
                            <!-- x:Name 供 View 单独测量本行绘图区几何（白方块要按 QP 量程换算像素高度） -->
                            <lvc:CartesianChart x:Name="QpChart"
                                                Series="{Binding QpChartSeries}"
                                                XAxes="{Binding QpXAxes}"
                                                YAxes="{Binding QpYAxes}"
                                                TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                AnimationsSpeed="0:0:0" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding QpMaxText}" Style="{StaticResource AxisRangeReadout}" />
                        <TextBlock Grid.Column="1" Text="{Binding QpMinText}" Style="{StaticResource AxisRangeReadout}"
                                   VerticalAlignment="Bottom" Margin="0,0,6,1" />
                    </Grid>

                    <!-- 4. MOTION -->
                    <Grid Grid.Row="3">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="运动矢量平均长度（fwd / bwd 共用）"
                                   Style="{StaticResource FloatingChartTitle}" />
                        <Border Grid.Column="1" Background="#FF0E0E14" CornerRadius="2">
                            <lvc:CartesianChart Series="{Binding MotionChartSeries}"
                                                XAxes="{Binding MotionXAxes}"
                                                YAxes="{Binding MotionYAxes}"
                                                TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                AnimationsSpeed="0:0:0" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding MotionMaxText}" Style="{StaticResource AxisRangeReadout}" />
                        <TextBlock Grid.Column="1" Text="0" Style="{StaticResource AxisRangeReadout}"
                                   VerticalAlignment="Bottom" Margin="0,0,6,1" />
                    </Grid>

                    <!-- 5. GOP -->
                    <Grid Grid.Row="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="GOP 距关键帧帧数" Style="{StaticResource FloatingChartTitle}"
                                   IsHitTestVisible="True"
                                   ToolTip="归零点取真关键帧(IDR)：白色满高标记就是这些对齐关键帧的位置。开放 GOP 流里存在非 IDR 的 I 帧，它们不归零、保持普通柱色 —— 和帧类型泳道对不齐属于该流本来的结构。" />
                        <Border Grid.Column="1" Background="#FF0E0E14" CornerRadius="2">
                            <lvc:CartesianChart Series="{Binding GopChartSeries}"
                                                XAxes="{Binding GopXAxes}"
                                                YAxes="{Binding GopYAxes}"
                                                TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                AnimationsSpeed="0:0:0" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding GopMaxText}" Style="{StaticResource AxisRangeReadout}" />
                        <TextBlock Grid.Column="1" Text="0" Style="{StaticResource AxisRangeReadout}"
                                   VerticalAlignment="Bottom" Margin="0,0,6,1" />
                    </Grid>

                    <!-- 6. REORDER（最底层显示时间刻度） -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="0" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="重排 pts-dts（帧）" Style="{StaticResource FloatingChartTitle}" />
                        <Border Grid.Column="1" Background="#FF0E0E14" CornerRadius="2">
                            <lvc:CartesianChart Series="{Binding ReorderChartSeries}"
                                                XAxes="{Binding ReorderXAxes}"
                                                YAxes="{Binding ReorderYAxes}"
                                                TooltipPosition="Hidden" LegendPosition="Hidden" ZoomMode="None"
                                                Margin="0,0,0,18"
                                                AnimationsSpeed="0:0:0" />
                        </Border>
                        <!-- 时间刻度条：自绘（见 TimeRuler.cs）。位置由 View 用图表自己的
                             「数据 → 像素」换算下发，与数据列严格对齐，也不占用轴的纵向空间。
                             高度按 11px 时刻文字的行高给足。
                             （不用 LiveCharts 画轴的另一个原因：绘图区高度不足时它整张图都不画，
                             实测 36px 以下的刻度条上轴刻度会完全不出现。） -->
                        <Border Grid.Column="1" Height="18" VerticalAlignment="Bottom"
                                Background="#FF0E0E14" CornerRadius="2" ClipToBounds="True">
                            <views:TimeRuler x:Name="TimeRulerBar" />
                        </Border>
                        <TextBlock Grid.Column="1" Text="{Binding ReorderMaxText}" Style="{StaticResource AxisRangeReadout}" />
                        <TextBlock Grid.Column="1" Text="0" Style="{StaticResource AxisRangeReadout}"
                                   VerticalAlignment="Bottom" Margin="0,0,6,1" />
                    </Grid>

                    <!-- ==================== 播放头覆盖层 ====================
                         整条竖线贯穿全部行（避免每张图各自画一段、上下留缺口），
                         并叠在柱状图之上；右侧同时显示该行当前值。 -->
                    <Rectangle Grid.Row="0" Grid.RowSpan="6"
                               Width="2" HorizontalAlignment="Left" VerticalAlignment="Stretch"
                               Fill="#DCF2F2FF" IsHitTestVisible="False" Panel.ZIndex="20"
                               Margin="{Binding PlayheadMargin}"
                               Visibility="{Binding PlayheadVisibility}" />

                    <TextBlock Grid.Row="0" Text="{Binding ReadoutBitrate}" Style="{StaticResource PlayheadReadout}"
                               Panel.ZIndex="21" Margin="{Binding PlayheadReadoutMargin}"
                               Visibility="{Binding PlayheadVisibility}" />

                    <!-- FRAME TYPE 行的读数（I/P/B 百分比）已去掉：三行泳道本身就按颜色区分了类型，
                         这行读数只是重复信息，还会挡住画面上方。 -->

                    <TextBlock Grid.Row="2" Text="{Binding ReadoutQp}" Style="{StaticResource PlayheadReadout}"
                               Panel.ZIndex="21" Margin="{Binding PlayheadReadoutMargin}"
                               Visibility="{Binding PlayheadVisibility}" />

                    <TextBlock Grid.Row="3" Text="{Binding ReadoutMotion}" Style="{StaticResource PlayheadReadout}"
                               Panel.ZIndex="21" Margin="{Binding PlayheadReadoutMargin}"
                               Visibility="{Binding PlayheadVisibility}" />

                    <TextBlock Grid.Row="4" Text="{Binding ReadoutGop}" Style="{StaticResource PlayheadReadout}"
                               Panel.ZIndex="21" Margin="{Binding PlayheadReadoutMargin}"
                               Visibility="{Binding PlayheadVisibility}" />

                    <TextBlock Grid.Row="5" Text="{Binding ReadoutReorder}" Style="{StaticResource PlayheadReadout}"
                               Panel.ZIndex="21" Margin="{Binding PlayheadReadoutMargin}"
                               Visibility="{Binding PlayheadVisibility}" />

                    <!-- 播放头处的当前播放时间：叠在时间刻度那一行的底部（不单独占一条带，底部省一行高度）。
                         横向挨着播放头竖线（同一个 _playheadOffset），纵向抬高几像素与刻度同一行；
                         样式沿用行读数那套（比刻度更醒目，便于一眼看到当前播放位置）。 -->
                    <TextBlock Grid.Row="5" Text="{Binding PositionText}" Style="{StaticResource PlayheadReadout}"
                               Panel.ZIndex="22" VerticalAlignment="Bottom"
                               Margin="{Binding PlayheadTimeMargin}"
                               Visibility="{Binding PlayheadVisibility}" />

                    <!-- QP 行：播放头右侧的白色小方块，纵向跟着本帧平均 QP 在 QP 量程里的位置移动
                         （尺寸与 ViewModel 里的 QpMarkerSize 一致） -->
                    <Rectangle Grid.Row="2" Width="7" Height="7" Fill="#FFFFFFFF"
                               HorizontalAlignment="Left" VerticalAlignment="Top"
                               IsHitTestVisible="False" Panel.ZIndex="22"
                               Margin="{Binding QpMarkerMargin}"
                               Visibility="{Binding QpMarkerVisibility}" />
                </Grid>
            </Border>
        </Grid>
    </DockPanel>

        <!-- ============ 忙碌提示层 ============
             冷启动初始化 / 打开源片 / 重开数据源期间整窗禁用（IsBusy），
             冷启动时 FFmpeg 原生库加载 + 编码器枚举可能持续数秒，只靠底部状态栏一行小字，
             用户会疑惑「按钮怎么灰了」。这里给一个同 UI 风格的居中方框：
             标题说明在干什么，副行实时显示 StatusText 的进度。 -->
        <Grid Background="#A00E0E14"
              Visibility="{Binding IsBusyOverlayVisible, Converter={StaticResource BoolToVisibility}}"
              Focusable="False">
            <Border HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="#FF16161E"
                    BorderBrush="{StaticResource PanelBorderBrush}"
                    BorderThickness="1" CornerRadius="6" Padding="28,20">
                <StackPanel>
                    <TextBlock Text="{Binding BusyOverlayTitle}"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="15" FontWeight="SemiBold"
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding StatusText}"
                               Style="{StaticResource DimText}"
                               Margin="0,8,0,0"
                               HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>

    </Grid>
</Window>
